CATE_FILE { "<Unused>" }    CLIENT_CERTIFICATE_PRIVATE_KEY_FILE { "<Unused>" }    CLIENT_CERTIFICATE_PASSWORD { "<Unused>" }    OUTPUT { OUTPUT FEATURE_TYPE HTTPCaller_8_Output          }    OUTPUT { REJECTED FEATURE_TYPE HTTPCaller_8_<REJECTED>          }
