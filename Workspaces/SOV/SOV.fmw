# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {Logger_4_ebcd3d98_bd0a_4816_a20a_674d090dbd0b1} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME Logger_4
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { Logger_4_Logger }    INPUT  FEATURE_TYPE JSONExtractor_3_<REJECTED>    OUTPUT { FEATURE_TYPE Logger_4_LOGGED                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>@EvaluateExpression(FDIV,STRING_ENCODED,Query<space><at>Value<openparen>Order<closeparen>:<space><at>Value<openparen>QueryName<closeparen><space>failed<space>to<space>produce<space>a<space>result:<lf><lf><at>Value<openparen>_response_body<closeparen>,Logger_4)","<Unused>","20","",ERROR,NONE,$(FME_UUID_SAFE))                   }
FACTORY_DEF * TeeFactory   FACTORY_NAME "Logger_4 LOGGED Transformer Output Nuker"   INPUT FEATURE_TYPE Logger_4_LOGGED
