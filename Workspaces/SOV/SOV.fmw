# Create the DomainName that this transformer will use.
# Because @Count itself will evalute the expression to calculate the
# domain, we don't need to do anything in Tcl per feature going by
INCLUDE [    set domainPrefix {};    if { {Local} == {Local} }    {       set domainPrefix [FME_EncodeText {$(BatchGrouper_WORKSPACE_NAME)_Counter_}];    };    puts "MACRO $(BatchGrouper_WORKSPACE_NAME)_Counter_FULL_DOMAIN ${domainPrefix}counter"; ]
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { $(BatchGrouper_WORKSPACE_NAME)_Counter_Rejector }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(BatchGrouper_WORKSPACE_NAME)_Input"    FUNCTION_DEFINITION { @Count(REJECTABLE,fme_encoded,$($(BatchGrouper_WORKSPACE_NAME)_Counter_FULL_DOMAIN),"0") }    RESULT_ATTRIBUTE { "_groupByCount" }    OUTPUT { COMPLETE FEATURE_TYPE "$(BatchGrouper_WORKSPACE_NAME)_Counter_OUTPUT"        }    OUTPUT { REJECTED FEATURE_TYPE "$(BatchGrouper_WORKSPACE_NAME)_Counter_<REJECTED>"        }
# -------------------------------------------------------------------------
INCLUDE TCL
   if {{OUTGOING} == {OUTGOING}} {      set attrs [list {$($(BatchGrouper_WORKSPACE_NAME)_VAL_ATTR)}];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    if {{NO_OP} == {NO_OP}} {        set parmList ATTR_CREATE_EXPR_PROPAGATE_MISSING_TYPED_FDIV;    } else {        set parmList ATTR_CREATE_EXPR_PROPAGATE_MISSING_TYPED_FDIV_MULTI_FEATURE;    };    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {<at>floor<openparen><at>Value<openparen>_groupByCount<closeparen><solidus>$($(BatchGrouper_WORKSPACE_NAME)_GROUP_SIZE$encode)<closeparen>};     lappend parmList {FLOAT};    };    lappend parmList {$(BatchGrouper_WORKSPACE_NAME)_ExpressionEvaluator};    if {{NO_OP} == {OTHER_NULL_VALUE_2}} {     lappend parmList {NO_OP};     lappend parmList {<Unused>};     lappend parmList {0};    };    puts "MACRO __fme_expressionevaluator_evaluateArgs__ [join $parmList ,]";
END_INCLUDE
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(BatchGrouper_WORKSPACE_NAME)_ExpressionEvaluator }    INPUT  FEATURE_TYPE "$(BatchGrouper_WORKSPACE_NAME)_Counter_OUTPUT"    OUTPUT { FEATURE_TYPE "$(BatchGrouper_WORKSPACE_NAME)_ExpressionEvaluator_OUTPUT"         @EvaluateExpression($(__fme_expressionevaluator_evaluateArgs__))          }
MACRO __fme_expressionevaluator_evaluateArgs__
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(BatchGrouper_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC }    } else {        puts "MACRO $(BatchGrouper_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(BatchGrouper_WORKSPACE_NAME)_AttributeRemover }    INPUT  FEATURE_TYPE "$(BatchGrouper_WORKSPACE_NAME)_ExpressionEvaluator_OUTPUT"    OUTPUT { FEATURE_TYPE "$(BatchGrouper_WORKSPACE_NAME)_AttributeRemover_OUTPUT"        @RemoveAttributes(fme_encoded,_groupByCount)        $($(BatchGrouper_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC)         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(BatchGrouper_WORKSPACE_NAME)_Output1778832206 Output Collector"   INPUT FEATURE_TYPE "$(BatchGrouper_WORKSPACE_NAME)_AttributeRemover_OUTPUT"   OUTPUT FEATURE_TYPE "$(BatchGrouper_WORKSPACE_NAME)_Output"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(BatchGrouper_WORKSPACE_NAME))}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "BatchGrouper Output Output Renamer/Nuker"   INPUT FEATURE_TYPE BatchGrouper_Output   OUTPUT FEATURE_TYPE BatchGrouper_Output
