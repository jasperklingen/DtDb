xt<openparen>path<closeparen><openbracket>1<closebracket>.lower<openparen><closeparen><lf><lf><space><space><space><space><space><space><space><space><space><space><space><space>if<space>ext<space>==<space><apos>.ttl<apos>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>with<space>open<openparen>path<comma><space><apos>r<apos><comma><space>encoding=<apos>utf-8<apos><closeparen><space>as<space>f:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>g<space>=<space>Graph<openparen><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>g.parse<openparen>data=f.read<openparen><closeparen><comma><space>format=<quote>turtle<quote><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>graph<space>=<space>graph<space>+<space>g<lf><lf><space><space><space><space><space><space><space><space><space><space><space><space>elif<space>ext<space>==<space><apos>.zip<apos>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>temp_dir<space>=<space>tempfile.mkdtemp<openparen><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>with<space>zipfile.ZipFile<openparen>path<comma><space><apos>r<apos><closeparen><space>as<space>zf:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>zf.extractall<openparen>temp_dir<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>for<space>root<comma><space>dirs<comma><space>files<space>in<space>os.walk<openparen>temp_dir<closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>for<space>fname<space>in<space>files:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>if<space>fname.lower<openparen><closeparen>.endswith<openparen><apos>.ttl<apos><closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>ttl_path<space>=<space>os.path.join<openparen>root<comma><space>fname<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>with<space>open<openparen>ttl_path<comma><space><apos>r<apos><comma><space>encoding=<apos>utf-8<apos><closeparen><space>as<space>f:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>g<space>=<space>Graph<openparen><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>g.parse<openparen>data=f.read<openparen><closeparen><comma><space>format=<quote>turtle<quote><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>graph<space>=<space>graph<space>+<space>g<lf><lf><space><space><space><space><space><space><space><space>newFeature.setAttribute<openparen><quote>graph<quote><comma><space>graph.serialize<openparen>format=<quote>turtle<quote><closeparen><closeparen><lf><space><space><space><space><space><space><space><space>self.pyoutput<openparen>newFeature<closeparen><lf><lf><space><space><space><space>def<space>reject_feature<openparen>self<comma><space>feature<comma><space>code<comma><space>message<closeparen>:<lf><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><quote>fme_rejection_code<quote><comma><space>code<closeparen><lf><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><quote>fme_rejection_message<quote><comma><space>message<closeparen><lf><space><space><space><space><space><space><space><space>self.pyoutput<openparen>feature<comma><space>output_tag=<quote><lt>Rejected<gt><quote><closeparen> }    PY_OUTPUT_TAGS { PYOUTPUT <Rejected> }    OUTPUT { PYOUTPUT FEATURE_TYPE PythonCaller_OUTPUT         }    OUTPUT { <Rejected> FEATURE_TYPE PythonCaller_<Rejected>         }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME PythonCaller_<Rejected> INPUT FEATURE_TYPE PythonCaller_<Rejected>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, PythonCaller<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {TempPathnameCreator_6fb0abe5_995c_4835_a20c_ae44c56da1bd7} ]
# On translation startup, prep the temporary directory that this instance of the
# xformer will populate with its temporary files.  We'll do this by asking for a
# temporary filename, and then instead of using it as a file, we'll add a _d suffix
# it which will become the directory we'll use for all the temp files we hand out.
# And we'll set up to have the END_TCL delete that entire directory when we shut down.
# To do that, we'll use the "environment" to hold our master subidirectory, keyed by
# our UUID as the environment variable name.  That is the only way to pass information
# from @Tcl2 to FME_END_TCL (via the "env" variable, because they use different Tcl
# interpretters)
Tcl2 set sampleTempFile [FME_TempFilename];      set ourTempDir {};      append ourTempDir $sampleTempFile {_d};      file mkdir $ourTempDir;      set env($(FME_UUID_SAFE)_dir) $ourTempDir;      set env($(FME_UUID_SAFE)_file) $sampleTempFile;      set gNumTempFilesHandedOut 0;
# Cleanup time. Remove the directory this transformer was using for its temp files, as well as the
# original temp file that was created as our "seed" to get us a unique starting point.
FME_END_TCL file delete -force $env($(FME_UUID_SAFE)_dir) $env($(FME_UUID_SAFE)_file) ;      unset env($(FME_UUID_SAFE)_dir);      unset env($(FME_UUID_SAFE)_file);
# Actually create and return a well formed filename that is guaranteed not to be there.
# We know we're working inside a directory unique to our instance of the transformer.
# So we can just increment serially within there to be sure we're not making a previously existing file
# We need to also provide a default for the filename base if they didn't give us one (we'll
# use the last 3 characters of the XFORMER_NAME), and take care to handle a no-extension-desired situation as well as
# a situation where the extension started with a .
Tcl2 proc TempPathnameCreator_makeTemp {baseName extension} {      global env;      global gNumTempFilesHandedOut;      if { [string length $extension ] == 0 } {          set extensionSep {};      } elseif { [string index $extension 0] == {.} } {          set extensionSep {};      } else {          set extensionSep {.};      };      if { $baseName == {} } {          set baseName [string range {TempPathnameCreator} end-2 end];      };      set curClock [clock clicks];      set last2ClockDigits [string range $curClock end-1 end];      append aGoodTempFile $env($(FME_UUID_SAFE)_dir) [file separator] [FME_DecodeText $baseName]                           $last2ClockDigits $gNumTempFilesHandedOut                           $extensionSep [FME_DecodeText $extension];      incr gNumTempFilesHandedOut;      FME_SetAttribute [FME_DecodeText _pathname] $aGoodTempFile; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { TempPathnameCreator }    INPUT  FEATURE_TYPE PythonCaller_OUTPUT    OUTPUT { FEATURE_TYPE TempPathnameCreator_OUTPUT         @Tcl2("TempPathnameCreator_makeTemp {} {}")          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { AttributeCreator_25 }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE TempPathnameCreator_OUTPUT    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    ATTR_ACTION { "" "_uuid" "SET_TO" "$(RUN_UUID$encode)" }      ATTR_ACTION { "" "metadataJSON" "SET_TO" "<opencurly><lf><space><space><space><space><quote>publicationUri<quote>:<space><quote><at>Value<openparen>_uuid<closeparen><quote><comma><lf><space><space><space><space><quote>name<quote>:<space><quote><at>Value<openparen>_uuid<closeparen><quote><comma><lf><space><space><space><space><quote>description<quote>:<space><quote>Dataset<space>for<space>statistics<space><openparen><at>Value<openparen>_uuid<closeparen><closeparen><quote><comma><lf><space><space><space><space><quote>owner<quote>:<space><quote>TenneT<quote><comma><lf><space><space><space><space><quote>publisher<quote>:<space><quote>FME<quote><comma><lf><space><space><space><space><quote>versioningMode<quote>:<space><quote>NONE<quote><comma><lf><space><space><space><space><quote>versionLabel<quote>:<space><quote><quote><comma><lf><space><space><space><space><quote>schemaURIs<quote>:<space><openbracket><space><closebracket><lf><closecurly>" }      ATTR_ACTION { "" "file_path" "SET_TO" "<at>Value<openparen>_pathname<closeparen><backslash><at>Value<openparen>_uuid<closeparen>.ttl" }    OUTPUT { OUTPUT FEATURE_TYPE AttributeCreator_25_OUTPUT        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { AttributeFileWriter }    INPUT  FEATURE_TYPE AttributeCreator_25_OUTPUT    FUNCTION_DEFINITION { @File(REJECTABLE,ENCODED_PARAMS,DestWriteSrcRead,graph,"@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>file_path<closeparen>,AttributeFileWriter)",utf-8) }    OUTPUT { COMPLETE FEATURE_TYPE AttributeFileWriter_OUTPUT        }    OUTPUT { REJECTED FEATURE_TYPE AttributeFileWriter_<REJECTED>        }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME AttributeFileWriter_<Rejected> INPUT FEATURE_TYPE AttributeFileWriter_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, AttributeFileWriter<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
# Combine the two "file path attribute" parameters into one value.
