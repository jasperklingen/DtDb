FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   MULTI_READER_KEYWORD $(DATASET_KEYWORD_XLSXR_1)   INPUT FEATURE_TYPE *    ROUTE XLSXR XLSXR_1::ImportQuerys multi_reader_keyword,$(DATASET_KEYWORD_XLSXR_1) TO FME_GENERIC ::ImportQuerys ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
XLSXR_1_MERGE_DEF XLSXR_1::ImportQuerys EXACT ImportQuerys DEFLINE xlsx_start_row,,xlsx_end_row,,xlsx_header_row,0,xlsx_schema_end_col,0,xlsx_schema_start_row,1,xlsx_schema_start_col,0,xlsx_schema_end_row,0,fme_attribute_reading,defined,Order,number<openparen>2<comma>0<closeparen>,Query,char<openparen>6597<closeparen>,Endpoint,char<openparen>338<closeparen>,Filename,char<openparen>14<closeparen>,Operation,char<openparen>34<closeparen>,Entrycode,char<openparen>13<closeparen>
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "ImportQuerys_XLSXR_1 Splitter"    INPUT FEATURE_TYPE ImportQuerys    OUTPUT FEATURE_TYPE ImportQuerys_XLSXR_1
DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Tester }    INPUT  FEATURE_TYPE ImportQuerys_XLSXR_1    TEST { Query ATTRIBUTE_HAS_A_VALUE "" ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE Tester_PASSED         }
# -------------------------------------------------------------------------
Tcl2 proc ParameterFetcher_doFetch {} {    foreach {name val} {"REL_ENDPOINT {$(REL_ENDPOINT)} REL_WORKSPACE {$(REL_WORKSPACE)} VS1_NameExtention {$(VS1_NameExtention$encode)} VS1_discriminator_value_TypeInsulation {$(VS1_discriminator_value_TypeInsulation$encode)} VS1_discriminator_value_TypeNoodstroomaggregaat {$(VS1_discriminator_value_TypeNoodstroomaggregaat$encode)} VS1_discriminator_value_TypeSecurity {$(VS1_discriminator_value_TypeSecurity$encode)} VS1_discriminator_value_TypeVoltageLevel {$(VS1_discriminator_value_TypeVoltageLevel$encode)}"} {         if { [string match {*<at>*} $val] == 1 } {             set val [FME_Execute EvaluateExpression {STRING} $val {ParameterFetcher}];         } elseif {[string match {*FME_CONDITIONAL*} $val] == 1} {             set val [FME_Execute EvaluateExpression {STRING} $val {ParameterFetcher}];         } else {             set val [FME_DecodeTextOrAttr $val];         };       FME_SetAttribute [FME_DecodeText $name] $val    } }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { ParameterFetcher }    INPUT  FEATURE_TYPE Tester_PASSED    OUTPUT { FEATURE_TYPE ParameterFetcher_OUTPUT         @Tcl2(ParameterFetcher_doFetch)          }
# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {NullAttributeMapper_31d29963_6939_4e0c_83b0_2878d344943d1} ]
Tcl2 proc $(FME_UUID_SAFE)_null_replacer { otherValue newValue regExp } {    set attrs [split {VS1_discriminator_value_TypeInsulation VS1_discriminator_value_TypeNoodstroomaggregaat VS1_discriminator_value_TypeSecurity VS1_discriminator_value_TypeVoltageLevel VS1_NameExtention} { }];    set decode true;    if { {SELECTED} == {ALL} } {       set attrs [FME_AttributeNames];       set decode false; 	 };    set decodedVal [FME_DecodeText $otherValue];    set decodedRegExp [FME_DecodeText $regExp];    foreach attr $attrs {      set act {NOOP};      if {$decode} {        set attr [FME_DecodeText $attr];      };      if {[FME_AttributeExists $attr]} {          set attrVal [FME_GetAttribute $attr];          if {[FME_IsAttributeNull $attr] } {             if {[string first {SETNULL} {SETNULL EMPTY MISSINGATTR}] != -1} {                 set act {EMPTY};             };          }          elseif { [string first {EMPTY} {SETNULL EMPTY MISSINGATTR}] != -1 && $attrVal == {}} {             set act {EMPTY};          }          elseif { $otherValue != {} && [string equal $attrVal $decodedVal]} {             set act {EMPTY};          }          elseif { $decodedRegExp != {} }          {             set results [FME_GetRegex $decodedRegExp $attrVal];             if {[llength [lindex $results 0]] > 0}             {                set act {EMPTY};             }          };      }      elseif {[string first {MISSINGATTR} {SETNULL EMPTY MISSINGATTR}] != -1} {             set act {EMPTY};      };      if {$act == {DELETEATTR} } {         FME_UnsetAttributes $attr;      } elseif { $act == {SETVALUE} } {         FME_SetAttribute $attr [FME_DecodeText $newValue];      } elseif { $act == {SETNULL} } {         FME_SetAttributeNull $attr;      } elseif { $act == {EMPTY} }      {         FME_SetAttribute $attr {};      };   }; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { NullAttributeMapper }    INPUT  FEATURE_TYPE ParameterFetcher_OUTPUT    OUTPUT { FEATURE_TYPE NullAttributeMapper_OUTPUT         @Tcl2("$(FME_UUID_SAFE)_null_replacer {} {<Unused>} {}")       }
# -------------------------------------------------------------------------
FACTORY_DEF {*} StringReplacerFactory    FACTORY_NAME { StringReplacer_2 }    INPUT  FEATURE_TYPE NullAttributeMapper_OUTPUT    USE_REGEX { YES }    CASE_SENSITIVE { NO }    SOURCE_ATTRIBUTES { VS1_discriminator_value_TypeInsulation,VS1_discriminator_value_TypeNoodstroomaggregaat,VS1_discriminator_value_TypeSecurity,VS1_discriminator_value_TypeVoltageLevel }    FIND_TEXT { "<opencurly>|<closecurly>" }    REPLACE_TEXT { "<quote>" }    REPLACE_NO_MATCH { "_FME_NO_OP_" }    OUTPUT { OUTPUT FEATURE_TYPE StringReplacer_2_OUTPUT          }
