# -------------------------------------------------------------------------

FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   MULTI_READER_KEYWORD $(DATASET_KEYWORD_XLSXR_2)   INPUT FEATURE_TYPE *    ROUTE XLSXR XLSXR_2::ImportQuerys multi_reader_keyword,$(DATASET_KEYWORD_XLSXR_2) TO FME_GENERIC ::ImportQuerys ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
XLSXR_2_MERGE_DEF XLSXR_2::ImportQuerys EXACT ImportQuerys DEFLINE xlsx_start_row,,xlsx_end_row,,xlsx_apply_filters,No,xlsx_header_row,0,xlsx_schema_end_col,0,xlsx_schema_start_row,1,xlsx_schema_start_col,0,xlsx_schema_end_row,0,fme_attribute_reading,defined,Order,number<openparen>2<comma>0<closeparen>,Query,char<openparen>6597<closeparen>,Endpoint,char<openparen>338<closeparen>,Filename,char<openparen>14<closeparen>,Operation,char<openparen>34<closeparen>,Entrycode,char<openparen>13<closeparen>
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "ImportQuerys_XLSXR_2 Splitter"    INPUT FEATURE_TYPE ImportQuerys    OUTPUT FEATURE_TYPE ImportQuerys_XLSXR_2
DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Tester }    INPUT  FEATURE_TYPE ImportQuerys_XLSXR_2    TEST { Query ATTRIBUTE_HAS_A_VALUE "" ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    OUTPUT { PASSED FEATURE_TYPE Tester_PASSED         }
# -------------------------------------------------------------------------
Tcl2 proc ParameterFetcher_doFetch {} {    foreach {name val} {"REL_ENDPOINT {$(REL_ENDPOINT)} REL_WORKSPACE {$(REL_WORKSPACE)} VS1_NameExtention {$(VS1_NameExtention$encode)}"} {         if { [string match {*<at>*} $val] == 1 } {             set val [FME_Execute EvaluateExpression {STRING} $val {ParameterFetcher}];         } elseif {[string match {*FME_CONDITIONAL*} $val] == 1} {             set val [FME_Execute EvaluateExpression {STRING} $val {ParameterFetcher}];         } else {             set val [FME_DecodeTextOrAttr $val];         };       FME_SetAttribute [FME_DecodeText $name] $val    } }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { ParameterFetcher }    INPUT  FEATURE_TYPE Tester_PASSED    OUTPUT { FEATURE_TYPE ParameterFetcher_OUTPUT         @Tcl2(ParameterFetcher_doFetch)          }
# -------------------------------------------------------------------------
   FACTORY_DEF {*} NullAttributeMapperFactory       FACTORY_NAME { NullAttributeMapperFactory }       INPUT  FEATURE_TYPE ParameterFetcher_OUTPUT       ATTRCHOICE { SELECTED }       ATTRLIST { VS1_NameExtention }       SOURCE_ATTR_VAL { SETNULL EMPTY MISSINGATTR }       OTHER_VAL {  }       REG_EXPR {  }       NULL_TREATMENT { EMPTY }       NEW_VAL { <Unused> }       OUTPUT { OUTPUT FEATURE_TYPE NullAttributeMapper_OUTPUT }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { AttributeCreator }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE NullAttributeMapper_OUTPUT    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    NUM_OF_COLUMNS 5    ATTR_ACTION { "" "VS1_NameExtention" "SET_TO" "FME_CONDITIONAL:DEFAULT_VALUE'_FME_NO_OP_'BOOL_OP;OR;COMPOSITE_TEST;1;TEST VS1_NameExtention ATTRIBUTE_HAS_A_VALUE _FME_BLANK_STRING_'<at>Value<openparen>VS1_NameExtention<closeparen><space>-<space>'FME_NUM_CONDITIONS2___" "buffer" }    OUTPUT { OUTPUT FEATURE_TYPE AttributeCreator_OUTPUT        }
# -------------------------------------------------------------------------
