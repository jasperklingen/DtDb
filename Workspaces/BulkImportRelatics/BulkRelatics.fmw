MACRO FeatureReader_OUTPUT_PORTS_ENCODED 
MACRO FeatureReader_DIRECTIVES ADVANCED_GROUP,FME_DISCLOSURE_OPEN,CASE_SENSITIVE_FIELD_NAMES,Yes,CHUNK_SIZE,100000,CSV2_EXPOSE_FORMAT_ATTRS,,DATA_START_LINE,2,DATASET_GROUP,,DATE_INPUT_FORMAT,%Y-%m-%d<lt>dollar<gt>,DELIMITER,<lt>comma<gt>,DELIMITER_DETECTION_ALGORITHM,EQUAL_FIELDS_PER_LINE,ENCODING,utf-8,ENCODING_GROUP,FME_DISCLOSURE_OPEN,ENFORCE_STRICT_SCHEMA,No,EXPOSE_ATTRS_GROUP,,FEATURE_TYPE_NAME,FILE_NAME,FIELD_NAMES_GROUP,FME_DISCLOSURE_CLOSED,FIELD_NAMES_LINE,1,FIELD_QUALIFIER_CHARACTER,<lt>quote<gt>,FIELD_QUALIFIER_ESCAPE_CHARACTER,<lt>quote<gt>,FIELD_SEPARATION_GROUP,FME_DISCLOSURE_OPEN,FIELD_VALUES_GROUP,FME_DISCLOSURE_CLOSED,FIELDS_GROUP,,PRESERVE_SOURCE_ENCODING,No,PREVIEW_PLACEHOLDER,,QUERY_FEATURE_TYPES_FOR_MERGE_FILTERS,Yes,READ_EMPTY_VALUES_AS,Null,READ_SKIPPED_LINES,No,REPLACE_ATTR_NAME_INVALID_CHARS,Yes,SCAN_ADDITIONAL_FIELDS,No,SCAN_MAX_ROWS,10000,SCAN_TYPES,Yes,SCHEMA,,SCHEMA_GENERATION_GROUP,FME_DISCLOSURE_OPEN,SKIP_DUPLICATE_DELIMITERS,No,SKIPPED_LINES_GROUP,FME_DISCLOSURE_CLOSED,STRING_TYPE_ATTRIBUTE_HANDLING,EXPLICIT_WIDTH,SUPPORTED_READER_ARCHIVE_EXTENSIONS,csv.gz<comma>txt.gz,TRIM_FEATURE_TYPE_NAME,Yes,TRIM_FIELD_NAME_QUALIFIERS,Yes,TRIM_FIELD_NAME_WHITESPACE,Yes,TRIM_FIELD_VALUE_QUALIFIERS,Yes,TYPE_ATTRIBUTE_HANDLING,STANDARD_TYPES,USE_CUSTOM_SCHEMA,NO
