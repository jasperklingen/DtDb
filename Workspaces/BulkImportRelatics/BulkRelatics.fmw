INCLUDE [ if {{$(InputJSON$encode)} == {}} { puts_real {Parameter 'InputJSON' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(SPARQL_OUTFOLDER$encode)} == {}} { puts_real {Parameter 'SPARQL_OUTFOLDER' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(BATCH_SIZE$encode)} == {}} { puts_real {Parameter 'BATCH_SIZE' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(TARGET_URL$encode)} == {}} { puts_real {Parameter 'TARGET_URL' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(RelaticsWorkspace$encode)} == {}} { puts_real {Parameter 'RelaticsWorkspace' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(AUTH_NAMED_CONNECTION$encode)} == {}} { puts_real {Parameter 'AUTH_NAMED_CONNECTION' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(RETRY_INITIAL_BACKOFF$encode)} == {}} { puts_real {Parameter 'RETRY_INITIAL_BACKOFF' must be given a value.}; exit 1; }; ]
