}    MINIMUM_ENCRYPTION_LEVEL { "OS_DEFAULT" }    CLIENT_CERTIFICATE_TYPE { "NONE" }    CLIENT_CERTIFICATE_FROM_OS { "<Unused>" }    CLIENT_CERTIFICATE_FILE { "<Unused>" }    CLIENT_CERTIFICATE_PRIVATE_KEY_FILE { "<Unused>" }    CLIENT_CERTIFICATE_PASSWORD { "<Unused>" }    OUTPUT { OUTPUT FEATURE_TYPE HTTPCaller_5_Output          }    OUTPUT { REJECTED FEATURE_TYPE HTTPCaller_5_<REJECTED>          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { Junction_5 }    INPUT  FEATURE_TYPE HTTPCaller_5_Output    INPUT  FEATURE_TYPE HTTPCaller_5_<REJECTED>    OUTPUT { FEATURE_TYPE Junction_5_Output         }
