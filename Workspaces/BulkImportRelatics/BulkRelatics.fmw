# Combine the two "file path attribute" parameters into one value.
DEFAULT_MACRO HTTPCaller_5_FILE_PATH_ATTR
INCLUDE [ 	if { {_response_file_path} == {<Unused>} } { 		puts {MACRO HTTPCaller_5_FILE_PATH_ATTR "<Unused>"}; 	} else { 		puts {MACRO HTTPCaller_5_FILE_PATH_ATTR "_response_file_path"}; 	} ]
