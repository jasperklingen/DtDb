def ParamFunc():
  from uuid import uuid4

  return str(uuid4())
value = ParamFunc()
macroName = 'RUN_UUID'
if value == None:
  return { macroName : u'' }
else:
  import six
  try:
    value = six.text_type(value)
  except UnicodeDecodeError:
    value = six.text_type(value, 'utf-8')
  return { macroName : value }
