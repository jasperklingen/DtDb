FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { AC_Query }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE AttributeKeeper_OUTPUT    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    NUM_OF_COLUMNS 5    ATTR_ACTION { "" "query" "SET_TO" "<at>Value<openparen>Query<closeparen>" "buffer" }    OUTPUT { OUTPUT FEATURE_TYPE AC_Query_OUTPUT        }
