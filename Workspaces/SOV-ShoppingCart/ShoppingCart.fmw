DEFAULT_MACRO StringConcatenator_728c3e01_6162_4e46_ae73_d5ebacd01efd5_ATTRS_TO_EVALUATE
INCLUDE [    if {{OUTGOING} == {OUTGOING}} {       if {[string length {_result}] == 0} { return; };       set attrs [list {_result}];    } else {       set attrs [split {<Unused>} { }];    };    set clauses {};    foreach attr $attrs {       lappend clauses "ATTR";       lappend clauses "{";       lappend clauses $attr;       lappend clauses {"<at>Value<openparen>child<closeparen><comma><at>Value<openparen>path<closeparen>"};       lappend clauses "}";    };    puts "MACRO StringConcatenator_728c3e01_6162_4e46_ae73_d5ebacd01efd5_ATTRS_TO_EVALUATE [join $clauses { }]"; ]
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { StringConcatenator }    INPUT  FEATURE_TYPE InlineQuerier_Tree    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    $(StringConcatenator_728c3e01_6162_4e46_ae73_d5ebacd01efd5_ATTRS_TO_EVALUATE)    OUTPUT { OUTPUT FEATURE_TYPE StringConcatenator_OUTPUT        }
