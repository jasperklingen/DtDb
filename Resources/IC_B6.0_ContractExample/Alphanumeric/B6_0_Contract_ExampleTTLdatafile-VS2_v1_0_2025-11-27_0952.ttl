  skos:prefLabel "Registreren, opslaan en rapporteren configuratiemanagement gegevens";
  skos:notation "6.3.5.3.d2" .

<http://data.tennet.eu/id/52f77bc8-53d2-ee11-b6a8-001dd8d702b3> a <http://data.tennet.eu/def/Document>;
