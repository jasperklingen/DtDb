  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/85482305-5d61-3fb1-945a-c338881ccd45> .

<http://data.tennet.eu/id/d0457ca5-54d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Aanstellen coordinator ontwerpfase";
  rdf:value "Opdrachtnemer dient een VGM-coördinator ontwerpfase aan te stellen overeenkomstig artikel 2.29 van het Arbeidsomstandighedenbesluit en de Opdrachtgever hierover binnen 2 weken naar gunning schriftelijk te informeren. De VGM coördinator ontwerpfase dient ten minste de taken overeenkomstig artikel 2.30 van het Arbeidsomstandighedenbesluit uit te voeren en voldoende bevoegdheid te hebben om de benodigde maatregelen in het kader van het Arbeidsomstandighedenbesluit door te voeren.";
  skos:notation "VS2-req-0249.01";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/985fc1a1-7046-3b2c-93a5-e95a7dd6ca9d> .

