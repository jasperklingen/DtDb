<http://data.tennet.eu/id/67929dc7-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Informatie schademelding CAR-verzekering";
  rdf:value """Opdrachtnemer dient de volgende informatie te verstrekken middels een formulier, indien zich schade voordoet binnen de CAR verzekering:
- projectnummer;
- Prijs (als genoemd in artikel 2 lid 4 van de Basisovereenkomst);
- datum van de schade;
- locatie van de schade;
- korte omschrijving van hetgeen is gebeurd;
- inschatting van het schadebedrag (niet bindend);
- soort project (onderhoud/nieuwbouw etc.).""";
  skos:notation "VS2-req-0588";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/31929dc7-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/d988c5c3-2297-3342-87a6-5f0e898e207d> .

<http://data.tennet.eu/id/df20441b-53d2-ee11-b6a8-001dd8d702b3> a <http://data.tennet.eu/def/VerificationPlan>;
  <http://data.tennet.eu/def/hasAsSubject> <http://data.tennet.eu/id/34e196c8-4dd2-ee11-b6a8-001dd8d702b3>;
