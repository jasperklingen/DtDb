<http://data.tennet.eu/id/fc5e95cd-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Opleverdossier - afwijkingen- en wijzigingenregister";
  rdf:value "Opdrachtnemer dient in het opleverdossier (een uitdraai van) het afwijkingen en Wijzigingen register met alle voor het Werk en de Werkzaamheden van toepassing zijnde Wijzigingen en afwijkingen vast te leggen.";
  skos:notation "VS2-0504-AFW";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/22d402d8-dec3-3a6c-a0ce-2ad96e385ccf> .

