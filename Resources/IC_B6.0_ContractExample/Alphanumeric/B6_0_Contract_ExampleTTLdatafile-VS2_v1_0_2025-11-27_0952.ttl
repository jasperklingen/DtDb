  skos:prefLabel "Weergeven bronvermelding gegevens";
  rdf:value "Opdrachtnemer dient invoergegevens van berekeningen te voorzien van een bronvermelding.";
  skos:notation "VS2-N-ARC-055";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/9d7fbcaf-52d2-ee11-b6a8-001dd8d702b3>;
