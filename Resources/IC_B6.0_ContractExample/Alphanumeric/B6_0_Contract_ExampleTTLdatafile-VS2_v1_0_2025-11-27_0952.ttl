<http://data.tennet.eu/id/4b3cc5a9-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Notulen voortgangoverleg";
  rdf:value "Opdrachtnemer dient notulen op te stellen van het voortgangsoverleg en deze ter kennis geving in te dienen bij Opdrachtgever.";
  skos:notation "VS2-req-0035.03";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/502290d5-9b14-3a6e-8b44-28e69056a76a> .

<http://data.tennet.eu/id/05da783a-4ed2-ee11-b6a8-001dd8d702b3> a owl:Class;
