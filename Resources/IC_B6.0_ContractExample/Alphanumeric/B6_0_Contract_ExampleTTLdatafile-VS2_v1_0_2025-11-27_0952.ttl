  skos:prefLabel "Bepalen systeemcontext en -grenzen qua raakvakken en interacties met externe entiteiten";
  skos:notation "6.4.4.3.c1" .

<http://data.tennet.eu/id/29fa0828-54d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Afhandelen restpunten zoals benoemd in bedrijfsvaardig gereed rapport";
  rdf:value "Opdrachtnemer dient alle restpunten zoals benoemd in het bedrijfsvaardig gereed rapport af te handelen, voorafgaand aan de oplevering van het Werk, zodanig dat het Werk aantoonbaar voldoet aan de gestelde eisen.";
  skos:notation "VS2-req-0874";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/545e5cae-f326-3a6f-b1b9-d7b9f9d78e1c> .

