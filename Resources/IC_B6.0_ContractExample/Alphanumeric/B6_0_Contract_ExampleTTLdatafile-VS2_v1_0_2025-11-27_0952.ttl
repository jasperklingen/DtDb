  skos:prefLabel "Realiseren of aanpassen systeemelementen conform de strategie, beperkingen en gedefinieerde implementatieprocedures";
  skos:notation "6.4.7.3.b1" .

<http://data.tennet.eu/id/571bae7b-54d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Recht van toegang OG";
  rdf:value "Opdrachtnemer dient TenneT-personeel altijd het recht van doorgang te verlenen, zodat terreinen van stakeholders en het Werkterrein te allen tijde bereikt kunnen worden.";
  skos:notation "VS2-req-0681";
  <http://data.tennet.eu/def/refersTo> <http://data.tennet.eu/id/921bae7b-54d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/bca09afe-97e0-30b0-96e3-114ab74de5b6> .

<http://data.tennet.eu/id/0c3690d3-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Ter kennis brengen schaderapporten";
  rdf:value "Opdrachtnemer dient alle (tussentijdse) schaderapporten met betrekking tot schade aan derden als bijlage bij het betreffend afwijkingsrapport ter kennis te brengen aan de Opdrachtgever.";
  skos:notation "VS2-req-034";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/60df44ce-2dad-3745-b223-321162474c9f> .

<http://data.tennet.eu/id/c417ae7b-54d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Toepassen Meetbestek";
  rdf:value "Opdrachtnemer dient het Meetbestek toe te passen.";
  skos:notation "VS2-req-7061";
  <http://data.tennet.eu/def/refersTo> <http://data.tennet.eu/id/055b2310-54d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/0ef02f3e-d709-38b1-ad1a-9c2a89dcdf32>;
  <http://data.tennet.eu/def/53c9026522802aefd2dc9cc234d52dda> "Opdrachtnemer dient dit meetbestek in te vullen conform de INWIN tool welke kan worden gevonden middels de volgende link: https://portals.tennet.eu/sites/TennetStandaarden/AssetDataManagement/TENNET_INWIN_ACAD.zip" .

<http://data.tennet.eu/id/57ef5709-53d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Aanstellen cultuurtechnisch toezichthouder";
  rdf:value "Opdrachtnemer dient een cultuurtechnisch functionaris aan te stellen die verantwoordelijk is voor een goede cultuurtechnische uitvoering van de Werkzaamheden. Deze functionaris is verplicht om de werkzaamheden af te stemmen en ter goedkeuring voor te leggen bij de cultuurtechnisch toezichthouder van de Opdrachtgever.";
  skos:notation "VS2-req-160";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/b1ee5709-53d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/2b72df29-4ff9-3b7f-87c3-8b10fb411c6b> .

