  skos:notation "6.4.1.3.c1" .

<http://data.tennet.eu/id/3584bcaf-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Garantie van een buitenlandse vennootschap";
  rdf:value """Opdrachtnemer dient, indien Opdrachtnemer een buitenlandse vennootschap is, te garanderen dat hij:
- geen vaste inrichting in Nederland heeft voor de Nederlandse loon –en/of omzetbelasting;
- een vaste vertegenwoordiger in Nederland heeft voor de Nederlandse loon –en/of omzetbelasting;
- geen werknemers in dienst heeft van wie de inkomsten worden belast in de Nederlandse inkomsten –en/of loonbelasting;
- geen loonadministratie in Nederland heeft en daarbij niet verzocht heeft aan de Nederlandse belastingdienst om te worden aangemerkt als inhoudsplichtige voor de loonbelasting;
- geen werknemers of anderen dan eigen werknemers heeft gedetacheerd in Nederland;
- geen werknemers in dienst heeft die werken op of boven het Nederlandse deel van het continentale plateau voor een aaneengesloten periode van ten minste 30 dagen;
- Opdrachtgever onmiddellijk en zonder enig voorbehoud schriftelijk nader zal informeren indien en een wijziging optreedt in één of meerdere van de hierboven omschreven garanties.""";
  skos:notation "VS2-req-0288";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/0283bcaf-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/e29a37ab-44f9-3ba7-8bda-bccb031f922c> .

<http://data.tennet.eu/id/ea7c75e6-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
  rdfs:subClassOf <https://w3id.org/nen2660/def#Activity>, <http://data.tennet.eu/def/ae14eaee-5b86-3d6f-8317-2bc826b5cec3>;
  skos:prefLabel "Bepalen en regelen vervoer en ontvangst van systeemelementen en faciliterende systemen";
  skos:notation "6.4.10.3.a7" .

<http://data.tennet.eu/id/fb61f462-53d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Inkoopproces";
  rdf:value "Opdrachtnemer dient zijn Werkzaamheden met betrekking tot het inkoop proces te verrichten zodanig dat de door Opdrachtnemer te leveren en in te kopen producten of diensten aantoonbaar en traceerbaar worden geleverd in overeenstemming met de vereisten uit de Overeenkomst en hieruit afgeleide eisen.";
  skos:notation "VS2-N-ACQ-001";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/344e342e-ea94-397a-b187-0c6e8d634096> .

<http://data.tennet.eu/id/15f9bd92-53d2-ee11-b6a8-001dd8d702b3> a <http://data.tennet.eu/def/VerificationPlan>;
