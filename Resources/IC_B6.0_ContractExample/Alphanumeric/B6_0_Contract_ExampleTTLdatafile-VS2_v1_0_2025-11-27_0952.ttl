  skos:prefLabel "Verzamelen, registreren en verifiëren gegevens";
  skos:notation "6.3.7.3.b2" .

<http://data.tennet.eu/id/c25f892e-4ed2-ee11-b6a8-001dd8d702b3> a owl:Class;
  rdfs:subClassOf <https://w3id.org/nen2660/def#Activity>, <http://data.tennet.eu/def/583f406b-c463-3b9d-92d9-7fafdb80de1e>;
