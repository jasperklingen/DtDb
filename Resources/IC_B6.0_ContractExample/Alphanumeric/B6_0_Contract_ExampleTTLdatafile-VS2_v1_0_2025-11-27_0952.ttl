  skos:prefLabel "Kwaliteitsmanagementorganisatie";
  rdf:value "Opdrachtnemer dient de kwaliteitsmanagementorganisatie te beschrijven, uitgewerkt voor de 1ste, 2de en 3de lijnscontroles.";
