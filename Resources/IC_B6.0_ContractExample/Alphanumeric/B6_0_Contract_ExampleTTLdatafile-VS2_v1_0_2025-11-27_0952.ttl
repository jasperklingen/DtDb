    <http://data.tennet.eu/id/0c62a4c1-52d2-ee11-b6a8-001dd8d702b3>, <http://data.tennet.eu/id/09651d6d-45ec-ee11-b6a9-001dd8d702ae> .

<http://data.tennet.eu/id/fb919dc7-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Aantonen veranderen ligging van huidige kabels en leidingen";
  rdf:value "Opdrachtnemer dient bij conflicterende kabels en leidingen aan te tonen dat de ligging van de huidige kabels en leidingen niet gehandhaafd kan blijven gegeven het ontwerp van het Werk en de Werkzaamheden.";
  skos:notation "VS2-req-0593.02";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/5d5fa4c1-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/2fa1b3b6-d1b6-35fc-81d6-e6da5cee4a9d> .

<http://data.tennet.eu/id/e55fa4c1-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Naleven CROW 500";
  rdf:value "Opdrachtnemer dient naast haar wettelijke verplichtingen in het kader van graafschade preventie, te voldoen aan CROW 500 Richtlijn Schade voorkomen aan kabels en leidingen - Richtlijn zorgvuldig grondroeren van initiatief- tot gebruiksfase.";
  skos:notation "VS2-req-0592.02";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/a05fa4c1-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/refersTo> <http://data.tennet.eu/id/fad5fa56-53d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/7b32fbc0-9f1d-3c9f-a1b2-09fcd2378bf3> .

<http://data.tennet.eu/id/a05fa4c1-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Voorkomen beschadigingen aan assets";
  rdf:value "Opdrachtnemer dient beschadiging van assets (incl. graafschade) zoveel als mogelijk te voorkomen.";
  skos:notation "VS2-req-0592.01";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/4f79216b-dde3-34f1-b95b-c7471b4ecf75> .

<http://data.tennet.eu/id/1d60a4c1-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Uitvoeren K&L Werkzaamheden";
  rdf:value "Opdrachtnemer dient Werkzaamheden met betrekking tot, of in de nabijheid van kabels en leidingen op een beheerste, expliciete en transparante wijze uit te voeren, zodanig dat de functies van kabels en leidingen in stand worden gehouden en de Werkzaamheden niet worden belemmerd.";
  skos:notation "VS2-req-0591";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/fcfa7092-51bc-3c03-9a26-ecf6c7ca7a10> .

<http://data.tennet.eu/id/5d5fa4c1-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Inventariseren conflicterende kabels en leidingen";
  rdf:value "Opdrachtnemer dient in de inventarisatie van kabels en leidingen, inzichtelijk te maken welke conflicterende kabels en leidingen aanwezig zijn in het kader van de Werkzaamheden en het Werk.";
  skos:notation "VS2-req-0593.01";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/2e5fa4c1-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/0f9b01f8-a185-37e4-a388-7ac72906e3e1> .

<http://data.tennet.eu/id/cd61a4c1-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Melden en afhandelen beschadigde kabels en leidingen";
  rdf:value "Opdrachtnemer dient bij het beschadigen van kabels en/of leidingen een schriftelijke melding te maken aan de betrokken kabel-, c.q. leidingbeheerder(s) en de manier van herstel en bijbehorende verantwoordelijkheden met de beheerder af te stemmen.";
  skos:notation "VS2-req-0599";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/f01e743a-c1d7-3019-86d2-2dfa9176a209> .

<http://data.tennet.eu/id/0c62a4c1-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Bijhouden register beschadigde kabels en leidingen";
  rdf:value """Opdrachtnemer dient een register beschadigde kabels en leidingen bij te houden, waarin tenminste per beschadigde kabel of leiding de volgende onderwerpen opgenomen zijn:
- datum van beschadigen kabel of leiding;
- naam en contactgegevens van eigenaar kabel of leiding;
- datum van reactie door Opdrachtnemer;
- manier van herstel van de schade, datum uitvoering herstel;
- vastlegging van afhandeling van herstel met eigenaar kabel of leiding op de wijze van afhandeling van de klacht;
- akkoord van eigenaar kabel of leiding op wijze van herstel en afhandeling hiervan.""";
  skos:notation "VS2-req-0707";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/cd61a4c1-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/f5ac14da-0db9-38f2-bad6-5b91d5de74da> .

<http://data.tennet.eu/id/0b540151-53d2-ee11-b6a8-001dd8d702b3> a <http://data.tennet.eu/def/VerificationPlan>;
  <http://data.tennet.eu/def/hasAsSubject> <http://data.tennet.eu/id/48e096c8-4dd2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isVerificationOf> <http://data.tennet.eu/id/0d2aaebb-52d2-ee11-b6a8-001dd8d702b3> .

