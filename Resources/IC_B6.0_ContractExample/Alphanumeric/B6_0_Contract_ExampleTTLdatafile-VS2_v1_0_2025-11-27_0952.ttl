  <http://data.tennet.eu/def/53c9026522802aefd2dc9cc234d52dda> "De definitie van projectfase is benoemd in annex II" .

<http://data.tennet.eu/id/65e096c8-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
  rdfs:subClassOf <https://w3id.org/nen2660/def#Activity>, <http://data.tennet.eu/def/92aa3054-9bdd-3109-b230-ebc63a7f2bbc>;
  skos:prefLabel "Uitvoeren K&L werkzaamheden";
