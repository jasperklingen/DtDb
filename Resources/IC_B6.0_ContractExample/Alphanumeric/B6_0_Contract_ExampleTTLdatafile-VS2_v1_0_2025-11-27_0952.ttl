  skos:notation "6.2.3.3.a8" .

<http://data.tennet.eu/id/0424aebb-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Opstellen detailbegroting, inhoud";
  rdf:value """Opdrachtnemer dient in de detailbegroting het volgende aan te geven:
a. Directe kosten, per post uitgesplitst naar:
i) hoeveelheden met bijbehorende eenheden;
ii) per eenheid productienormen, bestaande uit manuren, materieel en materiaal;
iii) eenheidsprijzen voor manuren, materieel en materiaal.

b. Indirecte kosten:
i) nadere uitsplitsing van eenmalige uitvoeringskosten;
ii) nadere uitsplitsing van tijdgebonden uitvoeringskosten;
iii) opslagpercentages voor algemene kosten en voor winst en voor risico (AKWR).""";
  skos:notation "VS2-req-0851.01";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/1679b5b5-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/refersTo> <http://data.tennet.eu/id/2db282c2-53d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/5e9a8ee6-7889-3683-9c8a-f292ae1605f9> .

<http://data.tennet.eu/id/2db282c2-53d2-ee11-b6a8-001dd8d702b3> a <http://data.tennet.eu/def/Document>;
  rdfs:seeAlso "https://sp-knowledge.alfa.local/sites/Projectenwiki/Contractdocumentatie/Forms/AllItems.aspx";
  skos:prefLabel "TenneT voorgeschreven kosten definities" .

