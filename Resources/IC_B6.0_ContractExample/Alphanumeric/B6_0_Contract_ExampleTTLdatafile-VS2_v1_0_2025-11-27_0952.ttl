<http://data.tennet.eu/id/fa7974eb-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Uitvoeren eisenanalyse";
  rdf:value "Opdrachtnemer dient alle eisen voor het Werk en de Werkzaamheden (uit de Overeenkomst en nader door Opdrachtnemer te decomponeren eisen) te analyseren, decomponeren, alloceren en structureren door middel van een eisenanalyse, ten einde dat eisen objectief verifieerbaar vast liggen voor start van de Ontwerpwerkzaamheden in eisenpakketten per object/Document.";
  skos:notation "VS2-req-0811";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/e86e5ceb-265e-3250-98ba-ef17007809bb> .

<http://data.tennet.eu/id/4839cda3-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Monitoren veiligheidsdoelstellingen";
  rdf:value "Opdrachtnemer dient de wijze en frequentie van monitoren ten aanzien van de veiligheidsdoelstellingen en bijbehorende KPI's te beschrijven.";
  skos:notation "VS2-req-0009.03";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/1e37cda3-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/06a862ca-ce24-3989-bbbf-f5e88d38917b> .

<http://data.tennet.eu/id/1e37cda3-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Beschrijven integraal veiligheidsmanagement";
  rdf:value "Opdrachtnemer dient de vormgeving van het integraal veiligheidsmanagement van het Werk te beschrijven.";
  skos:notation "VS2-req-0009.01";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/86c5d29d-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/b02ee33a-1e96-30db-8d60-249484709f15> .

<http://data.tennet.eu/id/ab24aebb-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Aanleveren detailbegroting, Excel format";
  rdf:value "Opdrachtnemer dient de detailbegroting in Excel format ter kennis te brengen aan Opdrachtgever.";
  skos:notation "VS2-req-0851.02";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/1679b5b5-52d2-ee11-b6a8-001dd8d702b3>;
