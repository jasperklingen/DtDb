  skos:notation "6.3.5.3c";
  <https://w3id.org/nen2660/def#hasRequirement> <http://data.tennet.eu/id/9cd988d9-52d2-ee11-b6a8-001dd8d702b3>,
    <http://data.tennet.eu/id/3cf089bc-53d2-ee11-b6a8-001dd8d702b3> .

<http://data.tennet.eu/id/7662a4c1-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Registreren vergunningen, inhoud";
  rdf:value """Opdrachtnemer dient in het vergunningenregister per vergunning ten minste het volgende aan te geven:
- een overzicht van alle voor het Werk en Werkzaamheden benodigde vergunningen op naam van Opdrachtnemer en vergunningen op naam van Opdrachtgever;
- de naam en adres van het bevoegd gezag;
- op welke wetgeving de betreffende vergunning betrekking heeft;
- het doel van de vergunning;
- op welk werkpakket de betreffende vergunning betrekking heeft;
- verwijzing naar een Document waarin de vergunningsvoorschriften en voorwaarden zijn verwoord;
- de status van de vergunning Opdrachtnemer;
- de geplande datum waarop de vergunning Opdrachtnemer verleend zal worden;
- de vergunningsvoorschriften en voorwaarden, inclusief een verwijzing naar de eisen waarin dit geborgd wordt;
- de uiterlijke datum waarop de vergunning benodigd is (mijlpaal);
- de (eventuele) verloopdatum van de geldigheid van de vergunningen.""";
  skos:notation "VS2-req-0550.02";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/4462a4c1-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/7409e3b6-b9ea-3a35-a607-20fde2c47e1c> .

