  skos:prefLabel "Registreren implementatieresultaat en eventuele geconstateerde afwijkingen";
  skos:notation "6.4.7.3.c1" .

<http://data.tennet.eu/id/da5f892e-4ed2-ee11-b6a8-001dd8d702b3> a owl:Class;
