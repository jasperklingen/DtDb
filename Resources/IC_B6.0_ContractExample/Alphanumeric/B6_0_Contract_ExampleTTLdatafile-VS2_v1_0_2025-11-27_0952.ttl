<http://data.tennet.eu/id/aa75b5b5-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Eisen aan administratie";
  rdf:value "Opdrachtnemer dient te controleren of de vreemdeling beschikt over een tewerkstellingsvergunning c.q. verblijfsvergunning en dit aantoonbaar in de administratie te verwerken.";
  skos:notation "VS2-req-0315";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/5075b5b5-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/07c921ab-295f-3032-a845-709b102db16b> .

