<http://data.tennet.eu/id/bfcf79e5-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Start Uitvoeringswerkzaamheden pas na afronden terreinnulinspecties";
  rdf:value "Opdrachtnemer dient niet eerder te starten met de Uitvoeringswerkzaamheden dan nadat de uitgangssituatie voor dat deel van zijn Werk of Werkzaamheden van belang is, is vastgelegd middels inspectie, analyse, aanvullend onderzoek.";
  skos:notation "VS2-req-046";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/face79e5-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/2f4a51ef-54f5-3143-a87c-83172c3d1c41> .

<http://data.tennet.eu/id/1675b5b5-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Financieel management";
  rdf:value "Opdrachtnemer dient Werkzaamheden met betrekking tot financieel management te verrichten, zodanig dat betalingen in verhouding (rechtmatig en doelmatig) staan tot het aantoonbaar geleverd (onderdeel van het) Werk.";
  skos:notation "VS2-req-0120";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/0f74b5b5-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/8a110d31-336f-37bc-9fca-35d434f5245e> .

<http://data.tennet.eu/id/d7d7783a-4ed2-ee11-b6a8-001dd8d702b3> a owl:Class;
  rdfs:subClassOf <https://w3id.org/nen2660/def#Activity>, <http://data.tennet.eu/def/d7e676ec-603e-3ebf-98ab-dfd0c5a73442>;
  skos:prefLabel "Delen kenniskapitaal in de organisatie";
  skos:notation "6.2.6.3.c3" .

<http://data.tennet.eu/id/e3b382c2-53d2-ee11-b6a8-001dd8d702b3> a <http://data.tennet.eu/def/VerificationPlan>;
  <http://data.tennet.eu/def/hasAsSubject> <http://data.tennet.eu/id/beeb77e0-4dd2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isVerificationOf> <http://data.tennet.eu/id/3b27aebb-52d2-ee11-b6a8-001dd8d702b3> .

<http://data.tennet.eu/id/3b27aebb-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Verrekening Wijzigingen en aanspraken van ON";
  rdf:value "Opdrachtnemer dient bij Wijzigingen overeenkomstig § 14, 15 en 45 UAV-GC 2005 en bij de berekening van aanspraken van de Opdrachtnemer op grond van § 44 UAV-GC 2005 de in de detailbegroting opgenomen prijzen, eenheidsprijzen en tarieven, alsmede de door TenneT voorgeschreven kostendefinities als uitgangspunt te hanteren voor directe kosten en indirecte kosten en dient de uitwerking hiervan te verwerken in het door Opdrachtgever verstrekt format voor de kostenonderbouwing van een Wijziging.";
  skos:notation "VS2-req-0137";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/1675b5b5-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/refersTo> <http://data.tennet.eu/id/2db282c2-53d2-ee11-b6a8-001dd8d702b3>,
    <http://data.tennet.eu/id/203aa8a4-53d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/8d2750d5-efd6-3c44-876c-1fdab5238ed0> .

<http://data.tennet.eu/id/2d0a61f8-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
  rdfs:subClassOf <https://w3id.org/nen2660/def#Activity>, <http://data.tennet.eu/def/c99d39a0-c905-3a30-a832-1eb9dd49d33b>;
  skos:prefLabel "Bepalen metingen die voldoen aan de informatiebehoeften";
  skos:notation "6.3.7.3.a4" .

<http://data.tennet.eu/id/abccf339-54d2-ee11-b6a8-001dd8d702b3> a <http://data.tennet.eu/def/VerificationPlan>;
