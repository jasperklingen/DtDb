<http://data.tennet.eu/id/2829c363-54d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Uitwerken werkwijze- en interactiemomenten stakeholders";
  rdf:value "Opdrachtnemer dient specifiek per fase de interactiemomenten en afhankelijkheden met stakeholders uit te werken die van toepassing zijn op de validaties in die fase.";
  skos:notation "VS2-N-VAL-044";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/e91c7e2d-c44b-3edb-9942-dd1c71c5503c> .

