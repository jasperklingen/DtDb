<http://data.tennet.eu/id/adf665f7-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Toepassen standaarden";
  rdf:value "Opdrachtnemer dient bij het opstellen van het UO en DO de generieke en gestandaardiseerde objecten en modules toe te passen in de oplossingen van de specifieke locatie.";
  skos:notation "VS2-BRP-049";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/9d7fbcaf-52d2-ee11-b6a8-001dd8d702b3>;
