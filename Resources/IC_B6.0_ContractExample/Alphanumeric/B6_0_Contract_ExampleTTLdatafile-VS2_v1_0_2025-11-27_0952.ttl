<http://data.tennet.eu/id/623c90ce-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
  rdfs:subClassOf <https://w3id.org/nen2660/def#Activity>, <http://data.tennet.eu/def/6fb180cf-597a-3009-84cb-747550f07919>;
