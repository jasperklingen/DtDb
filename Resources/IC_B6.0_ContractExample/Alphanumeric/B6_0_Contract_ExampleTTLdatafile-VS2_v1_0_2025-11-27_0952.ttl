<http://data.tennet.eu/id/3a7ebcaf-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Opstellen Uitvoerings Ontwerp";
  rdf:value "Opdrachtnemer dient een Uitvoerings Ontwerp (UO) van het gehele Werk op te stellen.";
  skos:notation "VS2-req-0391";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/8c29d47a-aaa9-31b8-a50f-8419186dd2a3> .

