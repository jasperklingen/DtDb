<http://data.tennet.eu/id/955c95cd-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Opleverdossier - terreineindinspectierapport";
  rdf:value "Opdrachtnemer dient in een opleverdossier het definitieve terreineindinspectierapport waaruit blijkt dat restpunten zijn afgehandeld vast te leggen.";
  skos:notation "VS2-0504-TER";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/b5eb895e-f358-35e8-9ffd-4ab5babd8d17> .

<http://data.tennet.eu/id/aa83bcaf-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Maatregelen treffen en medewerking verlenen aan OG";
  rdf:value "Opdrachtnemer dient maatregelen te nemen en waar gevraagd haar medewerking aan de Opdrachtgever te verlenen, ter voorkoming dat de Opdrachtgever door derden – waaronder begrepen de Belastingdienst – aansprakelijk wordt gesteld voor belastingen, premies, boetes, interest of andere wettelijk verschuldigde bedragen verschuldigd door de Opdrachtnemer en diens zelfstandige hulppersonen (waaronder onderaannemers).";
  skos:notation "VS2-req-0277";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/0283bcaf-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/7b641b7b-d47a-3077-b573-8ab0ed4ce5e9> .

