  skos:prefLabel "Bepalen taxonomie om kenniskapitaal te ordenen";
  skos:notation "6.2.6.3.c1" .

<http://data.tennet.eu/id/eff868f2-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
