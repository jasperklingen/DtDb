<http://data.tennet.eu/id/bd38cda3-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Functionaris integraal veiligheidsmanagement";
  rdf:value "Opdrachtnemer dient te beschrijven bij welke functionaris binnen het managementteam van Opdrachtnemer integrale veiligheid organisatorisch is belegd.";
  skos:notation "VS2-req-0009.05";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/1e37cda3-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/875757ed-502c-3907-a027-5077ca273326> .

