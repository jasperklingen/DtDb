  skos:prefLabel "Bepalen inhoud, template en medium informatiebeheer";
  skos:notation "6.3.6.3.a4" .

<http://data.tennet.eu/id/b17b75e6-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
