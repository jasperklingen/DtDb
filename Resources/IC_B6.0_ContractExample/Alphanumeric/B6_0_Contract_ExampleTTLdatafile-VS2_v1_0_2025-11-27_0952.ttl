  skos:notation "6.4.4.3.d5" .

<http://data.tennet.eu/id/adec5709-53d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Betreden percelen";
  rdf:value "Opdrachtnemer dient (ook als werkzaamheden worden uitgevoerd door Nevenopdrachtnemers en/of zelfstandige hulppersonen op basis van de coördinatieverplichting) de percelen pas te betreden, nadat de betreffende perceeleigenaar minimaal twee Werkdagen van te voren en voldoende is geïnformeerd (contactmomenten met grondeigenaren dan wel gebruikers / pachters).";
  skos:notation "VS2-req-064";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/9ff46cf1-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/b833afa1-3b9a-3c09-ace8-be3f0b2fd6ae> .

