  <http://data.tennet.eu/def/isVerificationOf> <http://data.tennet.eu/id/3b24aebb-52d2-ee11-b6a8-001dd8d702b3> .

<http://data.tennet.eu/id/3b24aebb-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Gebruik detailbegroting, verrekenen van Wijzigingen";
  rdf:value "Opdrachtnemer dient de detailbegroting zodanig uit te werken dat deze geschikt is om als basis te dienen voor het verrekenen van Wijzigingen gedurende het uitvoeren van de Overeenkomst, conform paragraaf 45 van de UAV-GC 2005.";
  skos:notation "VS2-req-0136.02";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/1679b5b5-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/a26bcf10-1533-3d05-8dcc-fe4c428b8ddc>;
  <http://data.tennet.eu/def/53c9026522802aefd2dc9cc234d52dda> "Tarieven voor het verrekenen van een bijzondere omstandigheid worden primair gebaseerd op de tarieven zoals genoemd in de detailbegroting. Daar waar deze niet zijn opgenomen dient in samenspraak met OG een tarief te worden vastgesteld." .

<http://data.tennet.eu/id/4665a4c1-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Wetsconforme afvoer en verwerking van afvalstoffen";
  rdf:value "Opdrachtnemer dient afvalstoffen af te voeren van de plaats waar zij vrijkomen pas nadat deze zijn voorzien van de transportpapieren benodigd voor wetsconforme afvoer.";
  skos:notation "VS2-req-0619";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/9364a4c1-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/9b6a0012-7404-3386-a4bd-bb4b1dfeba4e> .

<http://data.tennet.eu/id/9364a4c1-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Afvoeren en verwerken niet-afvalstoffen en afvalstoffen";
  rdf:value "Opdrachtnemer dient de vrijkomende materialen zoals bedoeld in annex V af te voeren en te verwerken conform de geldende wet- en regelgeving, voorschriften en aanvullend hierop gestelde eisen in de Overeenkomst.";
  skos:notation "VS2-req-0615.01";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/30f83b4f-480a-3c39-808f-54a0eae0bd46> .

