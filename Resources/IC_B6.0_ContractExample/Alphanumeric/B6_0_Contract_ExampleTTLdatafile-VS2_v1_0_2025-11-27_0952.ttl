  skos:prefLabel "Bepalen technologieën die nodig zijn voor elk systeemelement";
  skos:notation "6.4.5.3a1" .

<http://data.tennet.eu/id/6b592310-54d2-ee11-b6a8-001dd8d702b3> a <http://data.tennet.eu/def/VerificationPlan>;
  <http://data.tennet.eu/def/hasAsSubject> <http://data.tennet.eu/id/d57a75e6-4dd2-ee11-b6a8-001dd8d702b3>;
