  skos:prefLabel "Bepalen aanbevolen alternatieven voor aanpak risico";
  skos:notation "6.3.4.3.d1" .

<http://data.tennet.eu/id/648057fe-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
  rdfs:subClassOf <https://w3id.org/nen2660/def#Activity>, <http://data.tennet.eu/def/adf8c13a-626b-3008-b62a-b1255a9cdd0a>;
  skos:prefLabel "Beoordelen uitvoering van de overeenkomst";
  skos:notation "6.1.2.3.d2" .

<http://data.tennet.eu/id/828057fe-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
