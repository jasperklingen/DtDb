<http://data.tennet.eu/id/cc4681df-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Elektrische veiligheid opnemen in VGM plan uitvoeringsfase";
  rdf:value "Opdrachtnemer dient de risico's en maatregelen behorende bij het werken aan of in de nabijheid van spanningsvoerende delen op te nemen in het integrale projectspecifieke VGM-plan uitvoeringsfase.";
  skos:notation "VS2-req-0256";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/a14481df-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/af89fa3d-f820-3043-9bb5-97209c70a91d> .

<http://data.tennet.eu/id/a14481df-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Eisen VGM plan uitvoeringsfase";
  rdf:value "Opdrachtnemer dient het VGM-plan voor de uitvoeringsfase te baseren op het door hem ontwikkelde Veiligheids- en gezondheidsplan ontwerpfase. Veiligheids- en gezondheidsplannen dienen minimaal te voldoen aan de wettelijke eisen zoals gesteld in artikel 2.28 van het  Arbeidsomstandighedenbesluit en de daarin opgenomen uitgangspunten ten aanzien van de arbeid hygiënische strategie.";
  skos:notation "VS2-req-0255";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/5a4481df-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/refersTo> <http://data.tennet.eu/id/818d8b99-54d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/00b52561-4844-3584-9802-669dcc5b63db> .

