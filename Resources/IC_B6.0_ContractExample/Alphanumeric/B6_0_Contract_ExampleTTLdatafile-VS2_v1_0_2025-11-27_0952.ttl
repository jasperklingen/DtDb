  skos:prefLabel "Bepalen routekaart, benadering en strategie van de architectuurdefinitie";
  skos:notation "6.4.4.3.a3" .

<http://data.tennet.eu/id/d3d9783a-4ed2-ee11-b6a8-001dd8d702b3> a owl:Class;
