  skos:prefLabel "Bepalen en plannen faciliterende systemen of diensten ter ondersteuning van de archiutectuur definitie proces";
  skos:notation "6.4.4.3.a5" .

<http://data.tennet.eu/id/9ad9783a-4ed2-ee11-b6a8-001dd8d702b3> a owl:Class;
