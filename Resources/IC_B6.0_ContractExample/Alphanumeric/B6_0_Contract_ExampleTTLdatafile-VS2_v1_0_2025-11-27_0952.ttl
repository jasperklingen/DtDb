<http://data.tennet.eu/id/1f5b43f8-53d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Uitwerken werkwijze- en interactiemomenten stakeholders";
  rdf:value "Opdrachtnemer dient specifiek per fase de interactiemomenten en afhankelijkheden met stakeholders uit te werken die van toepassing zijn op de verificaties in die fase.";
  skos:notation "VS2-req-0012.04";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/1343f2dc-7c2c-39ae-b183-40bafdde0242> .

