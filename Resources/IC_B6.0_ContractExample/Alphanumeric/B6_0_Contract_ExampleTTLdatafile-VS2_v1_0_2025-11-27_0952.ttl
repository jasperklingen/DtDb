  skos:prefLabel "Veiligheid, gezondheid en milieu managementproces";
  <https://w3id.org/nen2660/def#hasPart> <http://data.tennet.eu/id/b4fd87d4-4dd2-ee11-b6a8-001dd8d702b3>,
