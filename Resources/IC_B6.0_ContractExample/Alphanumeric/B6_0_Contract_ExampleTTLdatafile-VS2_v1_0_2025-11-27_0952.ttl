  <https://w3id.org/nen2660/def#hasPart> <http://data.tennet.eu/id/53fb68f2-4dd2-ee11-b6a8-001dd8d702b3>,
    <http://data.tennet.eu/id/3dfb68f2-4dd2-ee11-b6a8-001dd8d702b3>, <http://data.tennet.eu/id/720761f8-4dd2-ee11-b6a8-001dd8d702b3>,
    <http://data.tennet.eu/id/510761f8-4dd2-ee11-b6a8-001dd8d702b3>, <http://data.tennet.eu/id/1f0761f8-4dd2-ee11-b6a8-001dd8d702b3>;
  skos:notation "6.4.8.3.a" .

<http://data.tennet.eu/id/173d90ce-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
  rdfs:subClassOf <https://w3id.org/nen2660/def#Activity>, <http://data.tennet.eu/def/29c13dbc-28fa-373b-9ebc-07bf3dad775b>;
  skos:prefLabel "Voorbereiden kwaliteitsborging";
  <https://w3id.org/nen2660/def#hasPart> <http://data.tennet.eu/id/220861f8-4dd2-ee11-b6a8-001dd8d702b3>,
    <http://data.tennet.eu/id/0c0861f8-4dd2-ee11-b6a8-001dd8d702b3>;
  skos:notation "6.3.8.3.a";
  <https://w3id.org/nen2660/def#hasRequirement> <http://data.tennet.eu/id/ed3690d3-52d2-ee11-b6a8-001dd8d702b3>,
