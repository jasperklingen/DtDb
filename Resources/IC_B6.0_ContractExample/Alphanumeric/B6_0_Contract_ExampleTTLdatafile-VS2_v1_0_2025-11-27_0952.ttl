<http://data.tennet.eu/id/f65a95cd-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Verzorgen ingebruikname systeem";
  rdf:value "Opdrachtnemer dient Opdrachtgever te ondersteunen en faciliteren bij de ingebruikname van het systeem.";
  skos:notation "VS2-req-0689.02";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/4fcdb373-4db4-3d10-8413-ffda3d4facc1> .

<http://data.tennet.eu/id/b5fb7bc8-53d2-ee11-b6a8-001dd8d702b3> a <http://data.tennet.eu/def/VerificationPlan>;
