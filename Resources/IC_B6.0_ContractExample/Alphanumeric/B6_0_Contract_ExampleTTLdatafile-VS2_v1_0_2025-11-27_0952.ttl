  skos:prefLabel "Verstrekken belangrijke informatie-items die zijn geselecteerd voor baselines voor bedrijfs- of missieanalyse proces";
  skos:notation "6.4.1.3.e2" .

<http://data.tennet.eu/id/fb5e892e-4ed2-ee11-b6a8-001dd8d702b3> a owl:Class;
