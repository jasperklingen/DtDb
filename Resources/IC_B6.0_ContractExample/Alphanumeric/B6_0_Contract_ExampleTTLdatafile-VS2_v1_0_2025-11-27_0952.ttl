  skos:prefLabel "Inhoud verificatieregister";
  rdf:value "Opdrachtnemer dient in het register per verificatie zowel het plan als de resultaten daarvan inzichtelijk te maken.";
  skos:notation "VS2-req-0667.03";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/eb39cda3-52d2-ee11-b6a8-001dd8d702b3>;
