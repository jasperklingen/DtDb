  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/fff539ed-b882-3a62-8dda-0eb70f1c3c18> .

<http://data.tennet.eu/id/24ef5709-53d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Onderzoeken bodemziekten";
  rdf:value "Opdrachtnemer dient, kort voor aanvang van de Uitvoeringswerkzaamheden, van elk te betreden perceel te bepalen of er bodemziekten aanwezig zijn door middel van een laboratoriumanalyse. Deze gegevens dienen voor betreding van het perceel door Opdrachtnemer ter kennisgeving overhandigd te worden aan Opdrachtgever.";
  skos:notation "VS2-req-080";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/b1ee5709-53d2-ee11-b6a8-001dd8d702b3>;
