  skos:prefLabel "Kwaliteitsborging zelfstandige hulppersonen";
  rdf:value "Opdrachtnemer dient het proces van interne kwaliteitsborging en interne audits met betrekking tot werkzaamheden uitgevoerd door zelfstandige hulppersonen te beschrijven.";
  skos:notation "VS2-req-0011.06";
