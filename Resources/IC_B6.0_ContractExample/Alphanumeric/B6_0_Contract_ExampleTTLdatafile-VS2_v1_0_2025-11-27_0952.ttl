  skos:notation "6.3.5.3.d1" .

<http://data.tennet.eu/id/8fa04f0a-4ed2-ee11-b6a8-001dd8d702b3> a owl:Class;
  rdfs:subClassOf <https://w3id.org/nen2660/def#Activity>, <http://data.tennet.eu/def/23a8b1ad-dbbc-3404-b6bb-97111c71aaa6>;
