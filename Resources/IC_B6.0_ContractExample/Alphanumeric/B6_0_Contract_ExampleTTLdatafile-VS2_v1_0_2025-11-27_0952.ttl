  skos:prefLabel "Terreinnulinspectie Gronden";
  rdf:value "Opdrachtnemer dient een terreinnulinspectie uit te voeren van de Gronden om de uitgangsituatie van de Gronden vast te stellen voor de Uitvoeringswerkzaamheden.";
  skos:notation "VS2-req-035";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/91cf79e5-52d2-ee11-b6a8-001dd8d702b3>;
