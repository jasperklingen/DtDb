<http://data.tennet.eu/id/a439c5a9-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Opstellen voortgangrapportage, zelfstandig leesbaar";
  rdf:value "Opdrachtnemer dient de voortgangsrapportage zodanig op te stellen dat deze zelfstandig gelezen kan worden.";
  skos:notation "VS2-req-0024.01";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/013ac5a9-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/ce147653-959d-3564-aa5d-b2e52ee58c1b> .

<http://data.tennet.eu/id/43f46cf1-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Coördinatie en afstemming met nood- en hulpdiensten";
  rdf:value "Opdrachtnemer dient de Werkzaamheden af te stemmen met nood- en hulpdiensten.";
  skos:notation "VS2-req-0562";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/625aa604-d6ab-374f-966e-682cbfa2af5d> .

<http://data.tennet.eu/id/de78b5b5-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Registreren ID en vergunning van tewerkgestelde vreemdelingen";
  rdf:value "Opdrachtnemer dient een geldig identiteitsbewijs en zo nodig tewerkstellingsvergunning te registreren van elke op het werkterrein aanwezige vreemdeling.";
  skos:notation "VS2-req-0314.02";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/7775b5b5-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/eaa58289-beeb-31ea-8f29-3a92d846cb00> .

<http://data.tennet.eu/id/7775b5b5-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Administreren van tewerkgestelde vreemdelingen";
  rdf:value "Opdrachtnemer dient een administratie bij te houden van tewerkgestelde vreemdelingen welke dient te voldoen aan artikel 15 van de Wav.";
  skos:notation "VS2-req-0314.01";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/5075b5b5-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/e7433248-d542-3e96-878e-5cbf74793c5a> .

<http://data.tennet.eu/id/293590d3-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Voorkomen betreding werkterrein door onbevoegden";
  rdf:value "Opdrachtnemer dient op de Werkterreinen maatregelen te treffen ter voorkoming van betreding door onbevoegden.";
  skos:notation "VS2-req-0679";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/e73490d3-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/91e1c92b-0a95-37f0-9299-564b68ad474a> .

<http://data.tennet.eu/id/e73490d3-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Veilig ombouwen";
  rdf:value "Opdrachtnemer is verantwoordelijk voor een veilige ombouw van het Werk, waarbij de werkzaamheden worden uitgevoerd met minimale verstoring voor de bedrijfsvoering van het transportnet en de omliggende stations.";
  skos:notation "VS2-req-0459";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/7c9b84c0-c4be-395e-80f3-2145c777fb57> .

<http://data.tennet.eu/id/53fb68f2-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
  rdfs:subClassOf <https://w3id.org/nen2660/def#Activity>, <http://data.tennet.eu/def/e34e9add-ef24-375a-9bc2-752e9158519f>;
  skos:prefLabel "Bepalen controlepunten voor de juiste werking en integriteit van de raakvlakken en de systeemfuncties";
  skos:notation "6.4.8.3.a1" .

<http://data.tennet.eu/id/6aaa1145-53d2-ee11-b6a8-001dd8d702b3> a <http://data.tennet.eu/def/VerificationPlan>;
  <http://data.tennet.eu/def/hasAsSubject> <http://data.tennet.eu/id/7de096c8-4dd2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isVerificationOf> <http://data.tennet.eu/id/8eaa1145-53d2-ee11-b6a8-001dd8d702b3> .

<http://data.tennet.eu/id/8eaa1145-53d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Verkrijgen en naleven vergunningen, ontheffingen, beschikkingen en/of toestemmingen";
  rdf:value "Opdrachtnemer dient alle voor het Werk en Werkzaamheden relevante vergunningen, ontheffingen, verklaringen van geen bezwaar en/of toestemmingen (hierna te noemen: vergunningen) te verkrijgen en na te leven welke niet zijn vermeld in annex I.";
  skos:notation "VS2-req-0515";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/81e7710b-baf2-3a9f-be07-32f984145e3c> .

<http://data.tennet.eu/id/073ccda3-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Beschrijven totstandkoming plannen";
  rdf:value "Opdrachtnemer dient te beschrijven hoe en door wie verificatieplannen tot stand komen.";
  skos:notation "VS2-N-VER-038";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/e03bcda3-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/48b83b27-12e7-3819-9832-5acc946ede29>;
  <http://data.tennet.eu/def/53c9026522802aefd2dc9cc234d52dda> "Er staat hier meervoud aan plannen. Het is aan de ON om te bepalen hoeveel plannen er ingediend worden voor deze eis. Als er meerdere plannen zijn dient ieder plan ingediend te zijn voordat de werkzaamheden waar de plannen op van toepassing zijn aanvangen." .

<http://data.tennet.eu/id/e5c67eda-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
