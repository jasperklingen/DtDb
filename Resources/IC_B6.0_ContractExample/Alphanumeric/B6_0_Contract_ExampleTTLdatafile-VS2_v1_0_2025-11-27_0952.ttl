<http://data.tennet.eu/id/51f868f2-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
  rdfs:subClassOf <https://w3id.org/nen2660/def#Activity>, <http://data.tennet.eu/def/6f80c2a0-32b1-34a4-91de-52dc79523c74>;
  skos:prefLabel "Monitoren corrigerende en preventieve maatregelen en stakeholders informeren";
  skos:notation "6.2.5.3.c3" .

<http://data.tennet.eu/id/6cf868f2-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
  rdfs:subClassOf <https://w3id.org/nen2660/def#Activity>, <http://data.tennet.eu/def/c8832984-938a-315f-b92b-afa7d83ed5bf>;
  skos:prefLabel "Plannen corrigerende maatregelen wanneer kwaliteitsmanagementdoelen niet worden behaald";
  skos:notation "6.2.5.3.c1" .

<http://data.tennet.eu/id/2cf868f2-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
  rdfs:subClassOf <https://w3id.org/nen2660/def#Activity>, <http://data.tennet.eu/def/6da5d66f-f02b-35d4-ad82-d5ab1663c4e0>;
  skos:prefLabel "Plannen preventieve maatregelen wannner er een risico is dat kwaliteitsmanagementdoelen niet zullen worden gehaald";
  skos:notation "6.2.5.3.c2" .

<http://data.tennet.eu/id/740e2bf3-54d2-ee11-b6a8-001dd8d702b3> a <http://data.tennet.eu/def/VerificationPlan>;
  <http://data.tennet.eu/def/hasAsSubject> <http://data.tennet.eu/id/76fd87d4-4dd2-ee11-b6a8-001dd8d702b3>;
