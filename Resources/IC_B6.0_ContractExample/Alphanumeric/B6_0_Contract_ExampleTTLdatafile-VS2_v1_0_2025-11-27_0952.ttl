  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/66e9bdb0-abe7-3a27-a28e-76171a0dc25c> .

<http://data.tennet.eu/id/13c4d29d-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Project Follow-Up (PFU)";
  rdf:value "Opdrachtnemer dient tenminste eenmaal een PFU te organiseren binnen de periode van 10 werkdagen voor aanvang van de Uitvoeringswerkzaamheden, danwel jaarlijks indien de Uitvoeringswerkzaamheden langer duren dan 1 jaar.";
  skos:notation "VS2-req-0634.01";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/68b52d5f-2f7c-3a6e-a4ec-d7c682aa3efc> .

<http://data.tennet.eu/id/c7aada97-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Minimaliseren aantal beperkingen in projectplanning";
  rdf:value "Opdrachtnemer dient in de projectplanning geen gebruik te maken van beperkingen (harde datums). Opdrachtnemer dient het gebruik van beperkingen in de planning te onderbouwen, indien het redelijkerwijs niet mogelijk is om de planning op te bouwen zonder beperkingen.";
  skos:notation "VS2-req-0109.01";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/37aada97-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/b79cae9a-5a6c-3068-abdc-5b1b180f64e1> .

<http://data.tennet.eu/id/01c1d29d-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Kwaliteitscontroles tijdens werkzaamheden";
  rdf:value "Opdrachtnemer dient het proces te beschrijven van interne kwaliteitsborging en interne audits met betrekking tot sturing en kwaliteitscontroles tijdens de werkzaamheden, specifiek uitgewerkt voor de fasen Ontwerp, Uitvoering en Oplevering.";
  skos:notation "VS2-req-0011.05";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/b6c0d29d-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/bf9e1be2-cee6-3781-95f8-7bba3436fcd0> .

<http://data.tennet.eu/id/38acda97-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Opstellen organogram";
  rdf:value "Opdrachtnemer dient een organogram van de projectorganisatie vast te leggen.";
  skos:notation "VS2-req-0013.02";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/d6abda97-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/5827b0da-d7b2-38fc-9b94-243bcaed7b54> .

<http://data.tennet.eu/id/95aada97-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Opbouw projectplanning, gesloten netwerk";
  rdf:value "Opdrachtnemer dient de projectplanning als gesloten netwerk op te zetten.";
  skos:notation "VS2-req-0093.02";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/37aada97-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/0ea9293b-f7b1-30f6-92fb-6f1d0522218a>;
  <http://data.tennet.eu/def/53c9026522802aefd2dc9cc234d52dda> "Dit betekent dat ieder werkpakket en/of activiteit een voorganger en een opvolger heeft, met uitzondering van het eerste en laatste werkpakket en/of activiteit." .

<http://data.tennet.eu/id/07acda97-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Sleutelfunctionarissen";
  rdf:value """Opdrachtnemer dient in de beschrijving van de projectorganisatie tenminste weer te geven: 
- sleutelfuncties met daaraan gekoppeld hun taken, verantwoordelijkheden en bevoegdheden;
- vervangers van de sleutelfunctionarissen die tijdens werkdagen voor Opdrachtgever bereikbaar zijn;
- in het geval het een Nadere overeenkomst onder de EU-301, EU-302 of EU-303 betreft, dan dienen de sleutelfunctionarissen overeen te komen met de opgenomen en goedgekeurde sleutelpersonen uit bijlage 8 van de desbetreffende Raamovereenkomst.""";
  skos:notation "VS2-req-0013.03";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/d6abda97-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/5ea9039d-355e-3ba0-bcc2-67d613dba728> .

<http://data.tennet.eu/id/b6c1d29d-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Delen resultaten audits";
  rdf:value """Opdrachtnemer dient een Auditregister op te stellen waarin de Audits bijgehouden worden.
Per Audit dient dit ten minste de volgende onderdelen te bevatten:
-  werkpakketnummer(s) waar de audit betrekking op heeft;
-  geplande datum van de audit;
-  datum uitgevoerde audit;
-  uniek auditnummer;
-  auditor;
-  resultaten audit.""";
  skos:notation "VS2-req-0011.08";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/b6c0d29d-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/dec80d3e-a51b-31f5-a17a-6a58cb0bda24> .

<http://data.tennet.eu/id/f2aada97-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Opbouw projectplanning, WBS";
  rdf:value "Opdrachtnemer dient de projectplanning conform de Work Breakdown Structure (WBS) op te bouwen.";
  skos:notation "VS2-req-0093.01";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/37aada97-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/15baa714-5961-358a-b21d-b3586e59ce7e> .

