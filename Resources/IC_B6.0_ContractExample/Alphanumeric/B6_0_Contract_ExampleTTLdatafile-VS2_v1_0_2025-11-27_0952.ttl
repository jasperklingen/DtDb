<http://data.tennet.eu/id/a07b74eb-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Risicosessie voor overgang naar nieuwe projectfase";
  rdf:value "Opdrachtnemer dient tenminste voorafgaand aan iedere overgang naar een nieuwe projectfase een gezamenlijke risicosessie te organiseren.";
  skos:notation "VS2-req-0082.02";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/757b74eb-52d2-ee11-b6a8-001dd8d702b3>;
