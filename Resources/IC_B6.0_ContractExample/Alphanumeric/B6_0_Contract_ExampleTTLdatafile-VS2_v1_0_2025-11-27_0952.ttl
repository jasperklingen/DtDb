<http://data.tennet.eu/id/b695a981-54d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Werkterrein in oorspronkelijke staat terugbrengen";
  rdf:value "Opdrachtnemer dient het Werkterrein terug te brengen in de oorspronkelijke staat na uitvoering van de Werkzaamheden.";
  skos:notation "VS2-req-0685";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/ad3e7a7e-0dc4-3fe5-8b2a-d73addf13334> .

