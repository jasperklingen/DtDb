<http://data.tennet.eu/id/974281df-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Melding ongeval met letsel- of milieuschade";
  rdf:value "Opdrachtnemer dient elk ongeval met letsel- of milieuschade terstond te melden bij Opdrachtgever.";
  skos:notation "VS2-req-0258.03";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/224281df-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/2511c5f4-6353-344a-89ee-2ab5f1fb6162> .

<http://data.tennet.eu/id/01d988d9-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Registreren van maatregelen en plandata";
  rdf:value "Opdrachtnemer dient binnen tien dagen na het constateren van een afwijking alle te treffen maatregelen inclusief plandata in het afwijkingenregister te verwerken.";
  skos:notation "VS2-req-0197";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/94d888d9-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/9eb2831c-0c23-3069-b49e-56737e5864ca> .

<http://data.tennet.eu/id/94d888d9-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Registreren van afwijkingen";
  rdf:value "Opdrachtnemer dient afwijkingen te registreren in het afwijkingenregister.";
  skos:notation "VS2-req-0192.01";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/89dfc458-ceaa-3e1b-8cd1-de286d17eaae> .

<http://data.tennet.eu/id/30f36cf1-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Eén verantwoordelijke hoofdconstructeur";
  rdf:value "Opdrachtnemer dient ten behoeve van de constructieberekeningen één verantwoordelijke hoofdconstructeur aan te wijzen, indien bouwwerken in meerdere delen worden gesplitst ten behoeve van de constructieberekeningen.";
  skos:notation "VS2-N-ARC-052";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/9d7fbcaf-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/2b0ed5dc-dae7-385d-a7f4-8d6460b5538e>;
  <http://data.tennet.eu/def/53c9026522802aefd2dc9cc234d52dda> "Stem per project af of de registerconstructeur de hoofdconstructeur is." .

<http://data.tennet.eu/id/9d7fbcaf-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Beheren ontwerp";
  rdf:value """Opdrachtnemer dient het ontwerp zodanig te detailleren en te documenteren, dat aangetoond kan worden dat het systeem:
- verifieerbaar aan de eisen uit de Overeenkomst voldoet;
- verifieerbaar aan de vergunningsvoorwaarden voldoet;
- veilig realiseerbaar is;
- veilig onderhoudbaar is;
- veilig voldoet aan het beoogde gebruik en
- waarbij raakvlakken en risico's zijn beheerst.""";
  skos:notation "VS2-N-ARC-038";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/541e0815-31b0-3ce0-9a71-f9774895fb3e> .

