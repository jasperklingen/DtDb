<http://data.tennet.eu/id/174481df-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Elektrische veiligheid opnemen in VGM-plan ontwerpfase";
  rdf:value "Opdrachtnemer dient elektrische veiligheid bij werken aan of in de nabijheid van hoogspanning op te nemen in het integraal veiligheid, gezondheid en milieu-plan (VGM-plan) ontwerpfase.";
  skos:notation "VS2-req-0252";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/e44381df-52d2-ee11-b6a8-001dd8d702b3>;
