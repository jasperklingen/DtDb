<http://data.tennet.eu/id/0d2aaebb-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Bijhouden afvalstoffenregister";
  rdf:value "Opdrachtnemer dient een actueel afvalstoffenregister bij te houden.";
  skos:notation "VS2-req-0624.01";
