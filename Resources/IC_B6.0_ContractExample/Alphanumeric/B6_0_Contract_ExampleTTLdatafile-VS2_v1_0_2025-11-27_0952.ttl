  skos:prefLabel "Bepalen hiërarchie en structuur van configuratie item";
  skos:notation "6.3.5.3.b2" .

<http://data.tennet.eu/id/60918b99-54d2-ee11-b6a8-001dd8d702b3> a <http://data.tennet.eu/def/VerificationPlan>;
