  skos:prefLabel "Uitvoeren configuratie wijzigingsbeheer";
  <https://w3id.org/nen2660/def#hasPart> <http://data.tennet.eu/id/827e57fe-4dd2-ee11-b6a8-001dd8d702b3>,
    <http://data.tennet.eu/id/d17e57fe-4dd2-ee11-b6a8-001dd8d702b3>, <http://data.tennet.eu/id/697e57fe-4dd2-ee11-b6a8-001dd8d702b3>,
