<http://data.tennet.eu/id/8a63a4c1-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Naleven gedragscode Flora- en faunawet soortenbescherming TenneT";
  rdf:value "Opdrachtnemer dient ten aanzien van de Werkzaamheden met betrekking tot de omgang met flora en fauna te voldoen aan de Gedragscode flora en Fauna van TenneT en het daarbij behorende werkprotocol, hierbij dient in dit document TenneT te worden gelezen als Opdrachtnemer.";
  skos:notation "VS2-req-0609.02";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/5763a4c1-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/refersTo> <http://data.tennet.eu/id/699b2f2d-53d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/1330fc0e-4fdc-3dce-8455-0dd8bfacb139> .

<http://data.tennet.eu/id/5763a4c1-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Naleven richtlijnen flora en fauna";
  rdf:value "Opdrachtnemer dient de beheerste omgang met flora en fauna te waarborgen waarbij de wettelijke voorschriften, wettelijke zorgplicht, regels en richtlijnen betreffende de flora en fauna worden nageleefd.";
  skos:notation "VS2-req-0609.01";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/908adc07-693c-377a-94bd-237beb9af158> .

<http://data.tennet.eu/id/699b2f2d-53d2-ee11-b6a8-001dd8d702b3> a <http://data.tennet.eu/def/Document>;
  rdfs:seeAlso "https://sp-teamsites.alfa.local/sites/WintrackIII/Actueel werkdossier ZWW3/ZWW-VE09 Gedragscode Flora en Fauna TenneT.pdf";
  skos:prefLabel "Gedragscode flora en Fauna van TenneT" .

