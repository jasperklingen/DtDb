  skos:prefLabel "Beheren traceerbaarheid van de bedrijfs- of missieanalyse";
  skos:notation "6.4.1.3.e1" .

<http://data.tennet.eu/id/14ea6eec-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
