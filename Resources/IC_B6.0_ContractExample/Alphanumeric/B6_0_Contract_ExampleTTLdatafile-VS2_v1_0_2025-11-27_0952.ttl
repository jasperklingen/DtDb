  skos:prefLabel "Bepalen evaluatiecriteria op basis van de zorgen en belangrijkste eisen van stakeholders";
  skos:notation "6.4.4.3.a4" .

<http://data.tennet.eu/id/1ada783a-4ed2-ee11-b6a8-001dd8d702b3> a owl:Class;
