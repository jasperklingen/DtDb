  skos:prefLabel "Monitoren van procesuitvoering in de hele organisatie";
  skos:notation "6.2.1.3.b1" .

<http://data.tennet.eu/id/2ae096c8-4dd2-ee11-b6a8-001dd8d702b3> a owl:Class;
  rdfs:subClassOf <https://w3id.org/nen2660/def#Activity>, <http://data.tennet.eu/def/44f7fc91-80e8-301d-8fc2-4dec4f9eb0dc>;
  skos:prefLabel "Waarborgen beheerste omgang niet gesprongen explosief";
  <https://w3id.org/nen2660/def#hasRequirement> <http://data.tennet.eu/id/128f2039-53d2-ee11-b6a8-001dd8d702b3>,
    <http://data.tennet.eu/id/e68f2039-53d2-ee11-b6a8-001dd8d702b3> .

<http://data.tennet.eu/id/128f2039-53d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Werkzaamheden NGCE";
  rdf:value "Opdrachtnemer dient Werkzaamheden met betrekking tot onverhoopt aangetroffen niet gesprongen explosieven (NGCE) te verrichten, zodanig dat een beheerste omgang met die niet gesprongen conventionele explosieven is gewaarborgd en dient de Werkzaamheden te verrichten conform het Systeemcertificaat Opsporen Conventionele Explosieven (WSCS-OCE).";
  skos:notation "VS2-req-0603.01";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/7ce4c2eb-851a-323e-947c-5b6db89fc15e> .

<http://data.tennet.eu/id/e68f2039-53d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Informeren aantreffen NGCE";
  rdf:value "Opdrachtnemer dient het bevoegd gezag en Opdrachtgever direct te informeren bij het onverhoopt aantreffen van een niet gesprongen explosief (NGCE) tijdens de uitvoering.";
  skos:notation "VS2-req-0603.02";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/dd02b537-d069-38d2-aea5-0a62a579aa41> .

<http://data.tennet.eu/id/a537c5a9-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Opstellen verificatieplan";
  rdf:value "Opdrachtnemer dient voor alle onderdelen van de verificatiescope een verificatieplan op te stellen.";
  skos:notation "VS2-req-0660.01";
  <http://data.tennet.eu/def/isDerivedIn> <http://data.tennet.eu/id/e03bcda3-52d2-ee11-b6a8-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/0dcc42a3-b634-35ed-8b77-38e46f900226> .

<http://data.tennet.eu/id/e03bcda3-52d2-ee11-b6a8-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Bepalen verificatieprocedure";
  rdf:value "Opdrachtnemer dient verificatieplannen nader uit te werken in overeenstemming met de integrale verificatiestrategie.";
  skos:notation "VS2-req-0677";
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/cd0055db-a7cc-36bc-b7f9-45d4e448d812>;
  <http://data.tennet.eu/def/53c9026522802aefd2dc9cc234d52dda> "De integrale verificatiestrategie zoals bedoeld in ISO 6.4.9.3.a.4 en zoals bedoeld in VS2-req-0012.02" .

