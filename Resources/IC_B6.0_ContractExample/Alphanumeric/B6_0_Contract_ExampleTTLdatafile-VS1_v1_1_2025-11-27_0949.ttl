<http://data.tennet.eu/id/41209b15-6c79-ee11-b6a1-001dd8d702b3> a <https://w3id.org/nen2660/def#Requirement>;
  skos:prefLabel "Terrein, machinaal groenbeheer";
  rdf:value "Het terrein dient ruimte te bieden aan machinaal groenbeheer.";
  skos:notation "AM-Req-0572.05";
  <http://data.tennet.eu/def/hasAsSource> <http://data.tennet.eu/id/973be4db-8479-ee11-b6a1-001dd8d702b3>;
  <http://data.tennet.eu/def/isDerivedFrom> <http://data.tennet.eu/id/cdc315f1-c7e6-38f3-b073-c7d69ac8a9e6>;
